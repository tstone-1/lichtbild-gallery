#: includes/class-lichtbild-migration-screen.php:362
msgid "Migrating moves the galleries onto Lichtbild's own post types. What it does:"
msgstr ""

#. translators: 1: galleries, 2: albums, 3: image tags.
#: includes/class-lichtbild-migration-screen.php:369
#, php-format
msgid "Renames %1$d galleries, %2$d albums and %3$d image tags to Lichtbild's types, in place. Post IDs do not change, so every [envira-gallery id=\"…\"] shortcode keeps working."
msgstr ""

#. translators: 1: convertible galleries, 2: Envira's defaults record count.
#: includes/class-lichtbild-migration-screen.php:380
#, php-format
msgid "Converts %1$d gallery records into Lichtbild's own format. %2$d are Envira's stored defaults rather than galleries and are skipped."
msgstr ""

#: includes/class-lichtbild-migration-screen.php:386
msgid "Keeps every URL exactly as it is. /envira/, /envira_album/ and /envira-tag/ continue to work and are still canonical."
msgstr ""

#: includes/class-lichtbild-migration-screen.php:387
msgid "Leaves Envira's own records untouched, so this can be reversed from this screen."
msgstr ""

#. translators: %d: number of galleries with no readable record.
#: includes/class-lichtbild-migration-screen.php:395
#, php-format
msgid "%d gallery has no readable record. It will be renamed but not converted, and will render as empty."
