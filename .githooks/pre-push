#!/usr/bin/env bash
# pre-push hook for public repositories.
# Blocks pushes that would leak internal-only content into GitHub.
# Reads the shared audit policy, but scans outgoing Git objects, never checkout files.
#
# Activate per-clone with: git config core.hooksPath .githooks
# Skip a single push (rare, use with care): SKIP_AGENT_MEMORY_AUDIT=1 git push

set -uo pipefail

if [ "${SKIP_AGENT_MEMORY_AUDIT:-}" = "1" ]; then
    echo "[pre-push] SKIP_AGENT_MEMORY_AUDIT=1 -- skipping public-safe audit."
    exit 0
fi

AUDIT=""

# Search the canonical agent-memory clone locations.
# Windows flat layout: $USERPROFILE/agent-memory/
# macOS hierarchical:  $HOME/Developer/github.com/tstone-1/agent-memory/
for candidate in \
    "${USERPROFILE:-}/agent-memory/bin/audit-agent-memory.ps1" \
    "$HOME/agent-memory/bin/audit-agent-memory.ps1" \
    "$HOME/Developer/github.com/tstone-1/agent-memory/bin/audit-agent-memory.ps1"; do
    case "$candidate" in /*|*:*) ;; *) continue ;; esac
    if [ -f "$candidate" ]; then
        AUDIT="$candidate"
        break
    fi
done

if [ -z "$AUDIT" ]; then
    echo "[pre-push] ERROR: audit script not found in any known location."
    echo "[pre-push] Looked for agent-memory/bin/audit-agent-memory.ps1 under:"
    echo "[pre-push]   \$USERPROFILE, \$HOME, \$HOME/Developer/github.com/tstone-1"
    echo "[pre-push] Push BLOCKED. Clone agent-memory or override with SKIP_AGENT_MEMORY_AUDIT=1."
    exit 1
fi

echo "[pre-push] Scanning outgoing commit trees and messages for forbidden content..."

PATTERNS_FILE="$(mktemp "${TMPDIR:-/tmp}/public-safe-patterns.XXXXXX")"
MESSAGE_FILE="$PATTERNS_FILE.messages"
commits="$PATTERNS_FILE.commits"
trap 'rm -f "$PATTERNS_FILE" "$MESSAGE_FILE" "$commits"' EXIT HUP INT TERM

# Prints the single-quoted entries of one PowerShell `$Name = @( ... )` list, one per line.
read_list() {
    awk -v name="$1" '
    $0 ~ ("^[[:space:]]*[$]" name "[[:space:]]*=") { in_list=1; next }
    in_list && /^[[:space:]]*\)/ { exit }
    in_list {
        line = $0
        sub(/^[[:space:]]*/, "", line)
        if (line ~ /^\047/) {
            sub(/^\047/, "", line)
            sub(/\047[[:space:]]*,?[[:space:]]*(#.*)?$/, "", line)
            gsub(/\047\047/, "\047", line)
            print line
        }
    }
    ' "$AUDIT"
}

read_list ForbiddenPatterns > "$PATTERNS_FILE"
read_list ForbiddenCommitMessagePatterns > "$MESSAGE_FILE"

# Both lists are required. A policy this hook cannot read is refused rather than replaced by a
# smaller ruleset: a scan with no message patterns passes every AI trailer, which is what this
# hook did while it read only the first list.
if [ ! -s "$PATTERNS_FILE" ] || [ ! -s "$MESSAGE_FILE" ]; then
    echo "[pre-push] ERROR: fallback could not read public-safe patterns from audit script."
    exit 1
fi

# Read the same literal file exceptions as the shared audit. Refuse an unreadable policy
# rather than silently substituting a different ruleset. The pattern list above is nonempty.
pathspecs=( . )
while IFS= read -r allowed; do
    [ -n "$allowed" ] && pathspecs+=( ":(exclude)$allowed" )
done < <(read_list AllowedFiles)

message_args=()
while IFS= read -r pattern; do
    message_args+=( "--grep=$pattern" )
done < "$MESSAGE_FILE"

# The policy is written as .NET regular expressions, and several entries rely on `\b` and `\s`.
# POSIX ERE has neither: under `git grep -E` on Apple Git a `\b`-anchored pattern matches
# nothing, so those entries could never block a push while the hook printed OK. PCRE reads
# them as written. A git built without it is refused, not scanned with the weaker engine.
pcre_checked=0
require_pcre() {
    [ "$pcre_checked" = 1 ] && return 0
    git rev-list -P --max-count=1 --grep='\bpcre\s?probe\b' "$1" > /dev/null 2>&1 || {
        echo "[pre-push] ERROR: this git cannot use Perl-compatible regexes (-P), which the" >&2
        echo "[pre-push] public-safe patterns need. Push BLOCKED." >&2
        exit 1
    }
    pcre_checked=1
}

while read -r local_ref local_oid remote_ref remote_oid; do
    if [[ ! "$local_oid" =~ ^[0-9a-f]{40,64}$ || ! "$remote_oid" =~ ^[0-9a-f]{40,64}$ ]]; then
        echo "[pre-push] ERROR: malformed ref input" >&2
        exit 1
    fi
    [[ "$local_oid" =~ ^0+$ ]] && continue # Deletion publishes no objects.
    require_pcre "$local_oid"
    revisions=( "$local_oid" )
    # On a new ref, inspect its entire reachable history. Remote-tracking refs may be
    # stale and are not evidence that the server already has a particular commit.
    if [[ ! "$remote_oid" =~ ^0+$ ]]; then
        revisions+=( "^$remote_oid" )
    fi
    git rev-list "${revisions[@]}" > "$commits" || {
        echo "[pre-push] ERROR: cannot enumerate outgoing history; fetch the remote and retry" >&2
        exit 1
    }
    # Messages over the same range. `--grep` matches line by line, so a pattern's `^` anchors a
    # trailer to the start of its line, as the shared audit's multiline mode does. Only commit
    # ids are printed, never the matching line.
    flagged=$(git rev-list -P -i "${message_args[@]}" "${revisions[@]}") || {
        echo "[pre-push] ERROR: message scan failed" >&2
        exit 1
    }
    if [ -n "$flagged" ]; then
        printf '%s\n' "$flagged"
        echo "[pre-push] FAIL - forbidden commit message in outgoing history; push blocked."
        exit 1
    fi
    while IFS= read -r commit; do
        # Print only object/file identifiers, never the matching proprietary value.
        git grep -l -I -i -P -f "$PATTERNS_FILE" "$commit" -- "${pathspecs[@]}"
        rc=$?
        if [ "$rc" -eq 0 ]; then
            echo "[pre-push] FAIL - forbidden content in outgoing history; push blocked."
            exit 1
        elif [ "$rc" -ne 1 ]; then
            echo "[pre-push] ERROR: object scan failed with exit code $rc" >&2
            exit "$rc"
        fi
    done < "$commits"
done
echo "[pre-push] OK - outgoing commit trees and messages passed."
