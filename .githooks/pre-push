#!/usr/bin/env bash
# pre-push hook for public repositories.
# Blocks pushes that would leak internal-only content into GitHub.
# Reads the shared audit policy, but scans outgoing Git objects, never checkout files.
#
# Activate per-clone with: git config core.hooksPath .githooks
# Skip a single push (rare, use with care): SKIP_AGENT_MEMORY_AUDIT=1 git push

set -uo pipefail

if [ "${SKIP_AGENT_MEMORY_AUDIT:-}" = "1" ]; then
    echo "[pre-push] SKIP_AGENT_MEMORY_AUDIT=1 -- skipping public-safe audit."
    exit 0
fi

AUDIT=""

# Search the canonical agent-memory clone locations.
# Windows flat layout: $USERPROFILE/agent-memory/
# macOS hierarchical:  $HOME/Developer/github.com/tstone-1/agent-memory/
for candidate in \
    "${USERPROFILE:-}/agent-memory/bin/audit-agent-memory.ps1" \
    "$HOME/agent-memory/bin/audit-agent-memory.ps1" \
    "$HOME/Developer/github.com/tstone-1/agent-memory/bin/audit-agent-memory.ps1"; do
    case "$candidate" in /*|*:*) ;; *) continue ;; esac
    if [ -f "$candidate" ]; then
        AUDIT="$candidate"
        break
    fi
done

if [ -z "$AUDIT" ]; then
    echo "[pre-push] ERROR: audit script not found in any known location."
    echo "[pre-push] Looked for agent-memory/bin/audit-agent-memory.ps1 under:"
    echo "[pre-push]   \$USERPROFILE, \$HOME, \$HOME/Developer/github.com/tstone-1"
    echo "[pre-push] Push BLOCKED. Clone agent-memory or override with SKIP_AGENT_MEMORY_AUDIT=1."
    exit 1
fi

echo "[pre-push] Scanning outgoing commit trees for forbidden content..."

PATTERNS_FILE="$(mktemp "${TMPDIR:-/tmp}/public-safe-patterns.XXXXXX")"
trap 'rm -f "$PATTERNS_FILE"' EXIT HUP INT TERM

awk "
/^[[:space:]]*\\\$ForbiddenPatterns[[:space:]]*=[[:space:]]*@\\(/ { in_list=1; next }
in_list && /^[[:space:]]*\\)/ { exit }
in_list {
    line = \$0
    sub(/^[[:space:]]*/, \"\", line)
    if (line ~ /^'/) {
        sub(/^'/, \"\", line)
        sub(/'[[:space:]]*,?[[:space:]]*(#.*)?$/, \"\", line)
        gsub(/''/, \"'\", line)
        print line
    }
}
" "$AUDIT" > "$PATTERNS_FILE"

if [ ! -s "$PATTERNS_FILE" ]; then
    echo "[pre-push] ERROR: fallback could not read public-safe patterns from audit script."
    exit 1
fi

# Read the same literal file exceptions as the shared audit. Refuse an unreadable policy
# rather than silently substituting a different ruleset. The pattern list above is nonempty.
pathspecs=( . )
while IFS= read -r allowed; do
    [ -n "$allowed" ] && pathspecs+=( ":(exclude)$allowed" )
done < <(awk '
    /^\$AllowedFiles[[:space:]]*=/ { active=1; next }
    active && /^[[:space:]]*\)/ { exit }
    active && /^[[:space:]]*\047/ {
        sub(/^[[:space:]]*\047/, ""); sub(/\047[[:space:]]*,?.*$/, ""); print
    }
' "$AUDIT")

commits="$PATTERNS_FILE.commits"
trap 'rm -f "$PATTERNS_FILE" "$commits"' EXIT HUP INT TERM
while read -r local_ref local_oid remote_ref remote_oid; do
    if [[ ! "$local_oid" =~ ^[0-9a-f]{40,64}$ || ! "$remote_oid" =~ ^[0-9a-f]{40,64}$ ]]; then
        echo "[pre-push] ERROR: malformed ref input" >&2
        exit 1
    fi
    [[ "$local_oid" =~ ^0+$ ]] && continue # Deletion publishes no objects.
    revisions=( "$local_oid" )
    # On a new ref, inspect its entire reachable history. Remote-tracking refs may be
    # stale and are not evidence that the server already has a particular commit.
    if [[ ! "$remote_oid" =~ ^0+$ ]]; then
        revisions+=( "^$remote_oid" )
    fi
    git rev-list "${revisions[@]}" > "$commits" || {
        echo "[pre-push] ERROR: cannot enumerate outgoing history; fetch the remote and retry" >&2
        exit 1
    }
    while IFS= read -r commit; do
        # Print only object/file identifiers, never the matching proprietary value.
        git grep -l -I -i -E -f "$PATTERNS_FILE" "$commit" -- "${pathspecs[@]}"
        rc=$?
        if [ "$rc" -eq 0 ]; then
            echo "[pre-push] FAIL - forbidden content in outgoing history; push blocked."
            exit 1
        elif [ "$rc" -ne 1 ]; then
            echo "[pre-push] ERROR: object scan failed with exit code $rc" >&2
            exit "$rc"
        fi
    done < "$commits"
done
echo "[pre-push] OK - outgoing commit trees passed."
