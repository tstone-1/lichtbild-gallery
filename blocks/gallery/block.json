{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lichtbild/gallery",
	"title": "Lichtbild Gallery",
	"category": "media",
	"icon": "format-gallery",
	"description": "Makes a new Lichtbild gallery, or places one that already exists.",
	"keywords": [ "gallery", "images", "photos", "envira" ],
	"textdomain": "lichtbild-gallery",
	"attributes": {
		"id": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"multiple": true,
		"reusable": true
	},
	"editorScript": "lichtbild-blocks",
	"editorStyle": "lichtbild-blocks"
}
